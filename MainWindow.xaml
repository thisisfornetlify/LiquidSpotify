<Window x:Class="LiquidSpotify.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Liquid Spotify" Icon="Assets/Player.ico" Width="408" Height="268" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" Background="Transparent" Foreground="{StaticResource Text}" FontFamily="{StaticResource PlayerFont}" Topmost="True" WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Border x:Name="Shell" CornerRadius="26" BorderThickness="1" MouseLeftButtonDown="DragWindow">
    <Border.BorderBrush>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0.85,1">
        <GradientStop Color="#72FFFFFF" />
        <GradientStop Color="#10FFFFFF" Offset="0.45" />
        <GradientStop Color="#3AFFFFFF" Offset="1" />
      </LinearGradientBrush>
    </Border.BorderBrush>
    <Grid x:Name="Surface" ClipToBounds="True">
      <Border CornerRadius="25">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#D4242529" />
            <GradientStop Color="#D018181B" Offset="0.7" />
            <GradientStop Color="#E01B1B1E" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Border CornerRadius="25">
        <Border.Background>
          <RadialGradientBrush Center="0,0.35" GradientOrigin="0,0.35" RadiusX="1.15" RadiusY="1.8">
            <GradientStop x:Name="GlowColor" Color="#5856768E" />
            <GradientStop Color="#00000000" Offset="1" />
          </RadialGradientBrush>
        </Border.Background>
      </Border>
      <Border x:Name="CoverCanvas" CornerRadius="25" Visibility="Collapsed">
        <Border.Background>
          <ImageBrush x:Name="FullArtwork" Stretch="UniformToFill" />
        </Border.Background>
      </Border>
      <Border x:Name="CoverShade" CornerRadius="25" Visibility="Collapsed" IsHitTestVisible="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#60040910" />
            <GradientStop Color="#00040910" Offset="0.27" />
            <GradientStop Color="#19040910" Offset="0.4" />
            <GradientStop Color="#C9090D15" Offset="0.7" />
            <GradientStop Color="#F2090C12" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Border CornerRadius="25" IsHitTestVisible="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
            <GradientStop Color="#12FFFFFF" />
            <GradientStop Color="#00FFFFFF" Offset="0.4" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Grid x:Name="LayoutRoot" Margin="22,12,22,14">
        <Grid.RowDefinitions>
          <RowDefinition x:Name="HeaderRow" Height="28" />
          <RowDefinition x:Name="SpacerRow" Height="0" />
          <RowDefinition x:Name="TrackRow" Height="96" />
          <RowDefinition x:Name="ControlsRow" Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="Header">
          <StackPanel x:Name="Brand" Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
            <Image Source="Assets/Logo.png" Width="24" Height="24" Margin="-2,0,5,0" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="Liquid" FontSize="11" FontWeight="Medium" Foreground="#D3DCE0" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,-8,0">
            <Button Style="{StaticResource IconButton}" Click="ToggleLyrics" ToolTip="Lyrics (Ctrl+L)" AutomationProperties.Name="Open lyrics">
              <Path Style="{StaticResource LineIcon}" Width="14" Height="14" Data="M 4,3 L 20,3 L 20,17 L 12,17 L 7,21 L 7,17 L 4,17 Z M 8,8 L 16,8 M 8,12 L 14,12" />
            </Button>
            <Button Style="{StaticResource IconButton}" Click="FullscreenLyrics" ToolTip="Fullscreen lyrics (F11)" AutomationProperties.Name="Fullscreen lyrics">
              <Path Style="{StaticResource LineIcon}" Width="13" Height="13" Data="M 3,9 L 3,3 L 9,3 M 15,3 L 21,3 L 21,9 M 21,15 L 21,21 L 15,21 M 9,21 L 3,21 L 3,15" />
            </Button>
            <Button x:Name="ArtworkButton" Style="{StaticResource IconButton}" ToolTip="Artwork view (Ctrl+E)" Click="ToggleArtwork" AutomationProperties.Name="Toggle artwork view" Visibility="Collapsed">
              <Path x:Name="ArtworkGlyph" Style="{StaticResource LineIcon}" Width="13" Height="13" Data="M 3,3 L 21,3 L 21,21 L 3,21 Z M 3,16 L 9,10 L 16,17 L 21,12 M 15,7 L 16,7" />
            </Button>
            <Button x:Name="CompactButton" Style="{StaticResource IconButton}" ToolTip="Compact mode (Ctrl+M)" Click="ToggleCompact" AutomationProperties.Name="Toggle compact mode" Visibility="Collapsed">
              <Path Style="{StaticResource LineIcon}" Width="13" Height="13" Data="M 3,7 L 21,7 L 21,17 L 3,17 Z M 7,10 L 7,14 M 11,10 L 18,10 M 11,14 L 16,14" />
            </Button>
            <Button x:Name="PinButton" Style="{StaticResource IconButton}" Foreground="#B6E6CE" ToolTip="Always on top: on" Click="TogglePin" AutomationProperties.Name="Toggle always on top" Visibility="Collapsed">
              <Path Style="{StaticResource LineIcon}" Width="13" Height="13" Data="M 8,3 L 16,3 M 9,3 L 9,10 L 6,14 L 18,14 L 15,10 L 15,3 M 12,14 L 12,21" />
            </Button>
            <Button Style="{StaticResource IconButton}" ToolTip="Minimize" Click="MinimizeWindow" AutomationProperties.Name="Minimize" Visibility="Collapsed">
              <Path Style="{StaticResource LineIcon}" Width="11" Height="11" Data="M 4,12 L 20,12" />
            </Button>
            <Button xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="PlayerMore" Style="{StaticResource IconButton}" Click="OpenPlayerMenu" ToolTip="Player options" AutomationProperties.Name="Player options" Tag="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
              <Button.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                  <MenuItem Header="Artwork view" InputGestureText="Ctrl+E" Click="ToggleArtwork" />
                  <MenuItem Header="Compact view" InputGestureText="Ctrl+M" Click="ToggleCompact" />
                  <Separator />
                  <MenuItem Header="Keep on top" IsCheckable="True" IsChecked="{Binding Topmost, Mode=TwoWay}" />
                  <Separator />
                  <MenuItem Header="Minimize" Click="MinimizeWindow" />
                </ContextMenu>
              </Button.ContextMenu>
              <TextBlock Text="•••" FontSize="13" FontWeight="Bold" Foreground="#D6D6DB" />
            </Button>
            <Button Style="{StaticResource IconButton}" ToolTip="Close player" Click="CloseWindow" AutomationProperties.Name="Close player">
              <Path Style="{StaticResource LineIcon}" Width="11" Height="11" Data="M 6,6 L 18,18 M 6,18 L 18,6" />
            </Button>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="2" x:Name="TrackPanel" Margin="0,6,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ThumbnailColumn" Width="90" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="CompactControlColumn" Width="0" />
          </Grid.ColumnDefinitions>
          <Border x:Name="Thumbnail" Width="78" Height="78" CornerRadius="15" Background="#12FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Center" BorderBrush="#25FFFFFF" BorderThickness="1" ToolTip="Expand artwork" MouseLeftButtonUp="ThumbnailClick" Cursor="Hand">
            <Grid>
              <TextBlock x:Name="Placeholder" Text="♪" FontSize="30" Foreground="#9CABBC" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Border CornerRadius="14">
                <Border.Background>
                  <ImageBrush x:Name="Artwork" Stretch="UniformToFill" />
                </Border.Background>
              </Border>
            </Grid>
          </Border>
          <StackPanel x:Name="TrackDetails" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0">
            <TextBlock x:Name="CoverEyebrow" Text="NOW PLAYING" FontSize="8" Foreground="#AFC1C8" Margin="0,0,0,7" Visibility="Collapsed" />
            <TextBlock x:Name="TrackTitle" Text="Connecting to Spotify…" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="Artist" Text="" Foreground="#B7C0CC" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
            <TextBlock x:Name="Album" Foreground="#798797" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
          </StackPanel>
          <Button x:Name="CompactPlay" Grid.Column="2" Style="{StaticResource IconButton}" Width="38" Height="38" Background="#13FFFFFF" BorderBrush="#20FFFFFF" VerticalAlignment="Center" Visibility="Collapsed" Click="PlayPause" AutomationProperties.Name="Play or pause">
            <Path x:Name="CompactPlayGlyph" Data="{StaticResource PlayGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="16" Stretch="Uniform" />
          </Button>
        </Grid>
        <Grid Grid.Row="3" x:Name="ExpandedControls">
          <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="57" />
            <RowDefinition x:Name="FooterRow" Height="*" />
          </Grid.RowDefinitions>
          <Grid>
            <Slider x:Name="Progress" Minimum="0" Maximum="1" Value="0" VerticalAlignment="Top" PreviewMouseLeftButtonDown="SeekStarted" PreviewMouseLeftButtonUp="SeekEnded" PreviewKeyDown="SeekKey" AutomationProperties.Name="Playback position" ToolTip="Seek" />
            <TextBlock x:Name="Elapsed" Text="0:00" FontSize="9" Foreground="#9FADBE" VerticalAlignment="Bottom" />
            <TextBlock x:Name="Duration" Text="–:––" FontSize="9" Foreground="#9FADBE" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
          </Grid>
          <Grid Grid.Row="1" Margin="0,3,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="52" />
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="52" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button x:Name="ShuffleButton" Style="{StaticResource IconButton}" Foreground="#AAB6C6" HorizontalAlignment="Left" Click="Shuffle" ToolTip="Shuffle" AutomationProperties.Name="Shuffle" ToolTipService.ShowOnDisabled="True">
              <Path Style="{StaticResource LineIcon}" Width="17" Height="17" Data="M 3,6 L 6,6 C 10,6 14,18 18,18 L 21,18 M 18,15 L 21,18 L 18,21 M 3,18 L 6,18 C 8,18 9,15 10,13 M 14,8 C 15,6 16,6 18,6 L 21,6 M 18,3 L 21,6 L 18,9" />
            </Button>
            <Button x:Name="PreviousButton" Grid.Column="1" Style="{StaticResource IconButton}" Width="40" Height="40" Click="Previous" ToolTip="Previous (Ctrl+Left)" AutomationProperties.Name="Previous track">
              <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="19" Height="18" Stretch="Uniform" Data="M 4,4 L 7,4 L 7,20 L 4,20 Z M 20,4 L 9,12 L 20,20 Z" />
            </Button>
            <Button x:Name="PlayButton" Grid.Column="2" Style="{StaticResource IconButton}" Width="48" Height="48" Background="#F3F3F6F9" Foreground="#17202B" BorderBrush="#FFFFFFFF" Click="PlayPause" ToolTip="Play / pause (Space)" AutomationProperties.Name="Play or pause">
              <Path x:Name="PlayGlyph" Data="{StaticResource PlayGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="17" Height="19" Stretch="Uniform" />
            </Button>
            <Button x:Name="NextButton" Grid.Column="3" Style="{StaticResource IconButton}" Width="40" Height="40" Click="Next" ToolTip="Next (Ctrl+Right)" AutomationProperties.Name="Next track">
              <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="19" Height="18" Stretch="Uniform" Data="M 17,4 L 20,4 L 20,20 L 17,20 Z M 4,4 L 15,12 L 4,20 Z" />
            </Button>
            <Button x:Name="RepeatButton" Grid.Column="4" Style="{StaticResource IconButton}" Foreground="#AAB6C6" HorizontalAlignment="Right" Click="Repeat" ToolTip="Repeat" AutomationProperties.Name="Repeat" ToolTipService.ShowOnDisabled="True">
              <Grid>
                <Path Style="{StaticResource LineIcon}" Width="18" Height="18" Data="M 4,10 L 4,8 C 4,6 5,5 7,5 L 20,5 M 17,2 L 20,5 L 17,8 M 20,14 L 20,16 C 20,18 19,19 17,19 L 4,19 M 7,16 L 4,19 L 7,22" />
                <TextBlock x:Name="RepeatOne" Text="1" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
              </Grid>
            </Button>
          </Grid>
          <Grid Grid.Row="2" x:Name="Footer" Margin="0,9,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse x:Name="StatusDot" Width="4" Height="4" Fill="#8691A9" Margin="0,0,6,0" />
              <TextBlock x:Name="Status" Text="Connecting" FontSize="9" Foreground="#8293A4" TextTrimming="CharacterEllipsis" MaxWidth="245" />
            </StackPanel>
            <Button Style="{StaticResource IconButton}" Width="24" Height="20" HorizontalAlignment="Right" Click="OpenSpotify" ToolTip="Open Spotify" AutomationProperties.Name="Open Spotify">
              <Path Style="{StaticResource LineIcon}" Width="12" Height="12" Data="M 14,3 L 21,3 L 21,10 M 21,3 L 10,14 M 10,5 L 4,5 L 4,21 L 20,21 L 20,15" />
            </Button>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
